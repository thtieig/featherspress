{% extends "base.njk" %}
{% block main %}
<h2 class="archive-title">{{ heading }}</h2>
{%- if posts.length %}
<div class="post-list">
{% for p in posts %}  <div class="post-card">
    <h2><a href="/{{ p.slug }}/">{{ p.title }}</a></h2>
    <div class="post-meta"><span>{{ p.date | date }}</span></div>
    <div class="post-tags">{% for t in p.tags %}<span class="tag">{{ t.name }}</span>{% endfor %}</div>
  </div>
{% endfor %}</div>
{%- else %}
<div class="post-list">
  <p style="color:var(--ink-faint)">No posts here yet.</p>
</div>
{%- endif %}
{% endblock %}
