# Featherspress backup configuration.
# Install to /etc/featherspress/backup.env  (root:root, chmod 600).
# Read by deploy/backup.sh (run as root from featherspress-backup.timer).

# --- Destination ---
# local  : copy to a local/mounted path (LOCAL_DIR). Same trust boundary as the
#          box, so encryption is optional.
# rclone : ship to any rclone remote (RCLONE_REMOTE) — S3, Dropbox, or SFTP over
#          ssh. Encryption is MANDATORY (AGE_RECIPIENT required).
DEST_TYPE=local

# For DEST_TYPE=local:
LOCAL_DIR=/var/backups/featherspress

# For DEST_TYPE=rclone: a configured remote + path. Set it up once with
# `rclone config`. Examples:
#   RCLONE_REMOTE=s3:my-bucket/featherspress
#   RCLONE_REMOTE=dropbox:featherspress
#   RCLONE_REMOTE=mybox:/srv/backups/featherspress   (an SFTP/ssh remote)
#RCLONE_REMOTE=

# --- Retention ---
# Keep the newest N backups at the destination; older ones are pruned.
KEEP_LAST=14

# --- Encryption (age) ---
# The RECIPIENT (public key) lives here; keep the matching PRIVATE key OFF the
# box (e.g. in a password manager). Generate a keypair with:  age-keygen
# Required whenever DEST_TYPE != local. Restore an encrypted artifact with:
#   age -d -i key.txt backup.tar.gz.age > backup.tar.gz
#AGE_RECIPIENT=age1qz...your-public-key...

# --- Paths (defaults are fine on a standard install) ---
#ENGINE_DIR=/opt/featherspress
#NODE_BIN=/opt/node/bin/node
