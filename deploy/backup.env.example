# Featherspress backup configuration for ONE site, instance @INSTANCE@.
# Lives at /etc/featherspress/@INSTANCE@/backup.env (root:root, chmod 600).
# deploy/add-instance.sh writes it from this file; after that the /admin
# Backups panel manages it. Read by deploy/backup.sh, run as root from
# featherspress-backup@@INSTANCE@.timer.

# --- Destination ---
# Every backup is kept on this server, in this site's own
# /var/backups/featherspress/@INSTANCE@ (the /admin backups list restores from
# there). Encryption is optional for that copy (same trust boundary as the box).
# local  : that is all.
# rclone : ALSO upload each backup to an rclone remote (S3, SFTP, Dropbox...),
#          as the safety copy for a lost server. Encryption is MANDATORY
#          (AGE_RECIPIENT required). The site's name is appended to the remote
#          path, so several sites can share one: s3:bucket/featherspress
#          becomes s3:bucket/featherspress/@INSTANCE@.
DEST_TYPE=local

# The local folder. It must be inside /var/backups/featherspress/@INSTANCE@.
LOCAL_DIR=/var/backups/featherspress/@INSTANCE@

# For DEST_TYPE=rclone: a remote set up once as root with `rclone config`, and
# a base path in it (the site's name is added). Examples:
#   RCLONE_REMOTE=s3:my-bucket/featherspress
#   RCLONE_REMOTE=mybox:backups/featherspress   (SFTP; relative to the login's home)
#RCLONE_REMOTE=

# --- Retention ---
# Keep the newest N backups, on this server and off-box; older ones are pruned.
KEEP_LAST=14

# --- Schedule ---
# What /admin shows. The timer itself runs daily at 00:20 until /admin
# changes it (through a featherspress-backup@@INSTANCE@.timer.d/ drop-in).
BACKUP_SCHEDULE_PRESET=daily
BACKUP_SCHEDULE_TIME=00:20

# --- Scope ---
# Which Site Package sections the scheduled backup captures: any comma-joined
# subset of content,media,site,settings,credentials. Leave unset/empty for all
# five. A scope missing "content" or "credentials" cannot fully restore the
# site — the /admin panel warns about this; this file does not enforce it.
#BACKUP_SECTIONS=content,media,site,settings,credentials

# --- Encryption (age) ---
# The RECIPIENT (public key) lives here; keep the matching PRIVATE key OFF the
# box (e.g. in a password manager). Easiest: press "Set up encryption" in
# /admin. Required whenever DEST_TYPE != local. Decrypt by hand with:
#   age -d -i key.txt backup.tar.gz.age > backup.tar.gz
#AGE_RECIPIENT=age1qz...your-public-key...

# --- Node (the default is the server's shared runtime) ---
#NODE_BIN=/opt/node/bin/node
