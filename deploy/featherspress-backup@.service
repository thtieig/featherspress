[Unit]
Description=Featherspress data backup for %i (Site Package, full profile)
# A failed run emails the owner itself (deploy/backup.sh → tools/notify.js)
# once /admin → Email alerts is set up. OnFailure= is only for a notifier of
# your own, and is left COMMENTED OUT on purpose: with no such unit installed,
# systemd just logs "Failed to enqueue OnFailure= job" and nothing happens. Add
# one through a drop-in (docs/BACKUP-IMPORT-EXPORT.md, "Email alerts"), and
# TEST it by forcing a failure.
#OnFailure=status-email@%n.service
#
# Check on it yourself:
#   systemctl is-failed featherspress-backup@<name>.service
#   systemctl list-timers 'featherspress-backup@*'
#   journalctl -u featherspress-backup@<name>.service --since -7d

[Service]
Type=oneshot
# Root: the backup reads auth-config.json and writes/prunes the destination.
# Config: /etc/featherspress/%i/backup.env (see deploy/backup.env.example).
ExecStart=/opt/featherspress/%i/deploy/backup.sh
# A hung run would otherwise hold the backup lock forever, and every later
# backup would quietly skip itself. Generous: a large site copied off-box over
# a slow line can take hours.
TimeoutStartSec=6h
