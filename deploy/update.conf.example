# Featherspress update configuration.
# Install to /etc/featherspress/update.conf  (root:root, chmod 600).
# Read ONLY by root's deploy/update.sh — NOT by the app (the unprivileged app
# cannot apply updates), so this operator toggle stays out of the app's env.

# Auto-apply updates?
#   0 = notify only (default): the timer checks and writes update-status.json;
#       the admin banner tells you an update is available; you apply it yourself
#       (see docs/DEPLOY.md).
#   1 = fully automatic: the timer also pulls, reinstalls deps, restarts, health-
#       checks, and rolls back on failure. Convenient, but a compromised upstream
#       commit auto-executes within one timer tick — opt in per box, knowingly.
AUTO_APPLY=0

# Git ref (branch) to track.
REPO_REF=main

# Overrides (defaults shown; usually leave commented):
#ENGINE_DIR=/opt/featherspress
#NODE_BIN=/opt/node/bin/node
#NPM_BIN=/opt/node/bin/npm
#SERVICE=featherspress
#FP_USER=featherspress
