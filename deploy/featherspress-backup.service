[Unit]
Description=Featherspress data backup (Site Package, full profile)
# Notify on failure — a silent backup failure means no backup when you need one.
# Point this at your own notifier unit (email/ntfy/etc.); status-email@%n is a
# common convention. Comment it out if you have no handler yet.
OnFailure=status-email@%n.service

[Service]
Type=oneshot
# Root: the backup reads auth-config.json and writes/prunes the destination.
ExecStart=/opt/featherspress/deploy/backup.sh
# Config lives in these files; see deploy/backup.env.example.
Environment=FP_ENV=/etc/featherspress/featherspress.env
Environment=BACKUP_ENV=/etc/featherspress/backup.env
