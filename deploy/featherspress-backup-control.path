[Unit]
Description=Watch the Featherspress backup request file (/admin -> root agent)

[Path]
# Fires the control agent when /admin writes a new backup request. Responsive
# (inotify). A rename-into-place may not always emit PathModified, so a 2-minute
# safety timer (featherspress-backup-control.timer) backstops any missed event;
# the agent is idempotent via requestId, so a double-trigger is harmless.
PathModified=/var/lib/featherspress/backup-request.json
Unit=featherspress-backup-control.service

[Install]
WantedBy=multi-user.target
