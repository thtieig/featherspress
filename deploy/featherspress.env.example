# Featherspress runtime configuration.
# Install to /etc/featherspress/featherspress.env  (root:root, chmod 640,
# readable by the featherspress group). Referenced by featherspress.service.

# --- Network ---
# Bound to localhost only; Apache reverse-proxies to it. Don't expose directly.
HOST=127.0.0.1
PORT=8787

# --- Data (lives OUTSIDE the code repo; treat as a database) ---
# Expected subdirs: posts/ and pages/.
CONTENT_DIR=/var/lib/featherspress/content
# Uploaded media, served at /media/.
MEDIA_DIR=/var/lib/featherspress/media
# Password hash + TOTP secret + recovery-code hashes (written by setup.js).
AUTH_CONFIG=/var/lib/featherspress/auth-config.json

# --- Session secret ---
# Generate once with:  openssl rand -hex 32
# If you leave the dev default, sessions are insecure. REPLACE IT.
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Site identity ---
# Prefer a site.json in the content dir (or a SITE_PACKAGE). These env vars are
# only used to synthesize a manifest when there is no site.json.
SITE_TITLE=My Blog
SITE_TAGLINE=
SITE_URL=https://example.com
