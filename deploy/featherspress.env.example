# Featherspress runtime configuration for ONE site, instance @INSTANCE@.
# Lives at /etc/featherspress/@INSTANCE@/featherspress.env (root:fp-@INSTANCE@,
# chmod 640). deploy/add-instance.sh writes it from this file; systemd reads it
# for featherspress@@INSTANCE@.service.
#
# QUOTE ANY VALUE CONTAINING SPACES. systemd's EnvironmentFile= would take a
# bare `SITE_TITLE=My Blog` literally, but deploy/backup.sh and deploy/update.sh
# `source` this file with a shell, which parses that as the assignment
# `SITE_TITLE=My` followed by the command `Blog` — and the backup dies before it
# ever runs. Quoted values are correct for both readers.

# --- Network ---
# Bound to localhost only; this site's Apache vhost proxies to it. Every site
# on the server has its own port.
HOST=127.0.0.1
PORT=8787

# --- Data (lives OUTSIDE the code checkout; treat it as a database) ---
# The site's data dir, laid out as a Site Package: site.json, content/,
# media/, skins/, favicon/, auth-config.json, plus the status and request
# files the root agents use. Everything else is derived from this one path.
SITE_PACKAGE=/var/lib/featherspress/@INSTANCE@

# --- Session secret (required for /admin) ---
# Generate once with:  openssl rand -hex 32   (add-instance.sh does this)
# /admin stays disabled (503) while this is missing, still a CHANGE_ME
# placeholder, or shorter than 32 characters.
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Site identity ---
# Only used to make up a manifest while the site has no site.json yet.
#SITE_TITLE="My Blog"
#SITE_TAGLINE=""
#SITE_URL="https://example.com"
