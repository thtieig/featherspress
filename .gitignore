# A real site's content & media live outside the engine, so never commit them.
# site.json is a site's manifest (part of its private Site Package), not the
# shippable engine. (The bundled demo lives under example-site/ and IS tracked.)
/content/
/media/
/site.json

# Site-specific skins are customizations, not the engine: a site's look travels
# with its Site Package, not this repo. The bundled default skin (skins/notepad)
# is tracked; anything else under skins/ is a per-site skin kept on disk but out
# of the repo (it may also recreate a third-party theme we can't redistribute).
/skins/*
!/skins/notepad/

# Secrets / local auth state.
auth-config.json

# Dependencies & build output.
node_modules/

# Python virtualenv for the converter (created per the migration guide).
.venv/
/converter/.venv/

# Editor / OS cruft.
*.log
.DS_Store
.vscode/
.idea/

# Scratch
*.tmp
/wp-content/
/plans/

# Python bytecode
__pycache__/
*.pyc
